{{- $items := slice -}}
{{- range first 20 (where site.RegularPages "Section" "posts").ByDate.Reverse -}}
  {{- $tags := slice -}}
  {{- range .GetTerms "tags" -}}
    {{- $tags = $tags | append .LinkTitle -}}
  {{- end -}}
  {{- $items = $items | append (dict
    "id" .Permalink
    "url" .Permalink
    "title" .Title
    "summary" (cond (ne .Description "") .Description (.Summary | plainify))
    "content_html" .Content
    "date_published" (.Date.Format "2006-01-02T15:04:05Z07:00")
    "date_modified" (.Lastmod.Format "2006-01-02T15:04:05Z07:00")
    "tags" $tags
  ) -}}
{{- end -}}
{{- $feed := dict
  "version" "https://jsonfeed.org/version/1.1"
  "title" site.Title
  "home_page_url" site.BaseURL
  "feed_url" ("feed.json" | absURL)
  "description" site.Params.description
  "language" (site.Language.Locale | default "en-US")
  "authors" (slice (dict "name" site.Params.author "url" (absURL "/about/")))
  "items" $items
-}}
{{ $feed | jsonify (dict "indent" "  ") }}
